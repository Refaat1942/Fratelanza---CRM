# Fratelanza CRM Environment Configuration
# Copy to .env and adjust values before deployment

SECRET_KEY=your-super-secret-key-change-in-production
BRAND_NAME="Fratelanza CRM"
POSTGRES_USER=fratelanza
POSTGRES_PASSWORD=fratelanza_secret_change_me
POSTGRES_DB=fratelanza_crm
DATABASE_URL=postgresql+psycopg://fratelanza:fratelanza_secret_change_me@db:5432/fratelanza_crm

APP_PORT=16350
APP_DOMAIN=crm.fratelanza.com
ACME_EMAIL=admin@fratelanza.com
DEFAULT_LANGUAGE=ar
FLASK_DEBUG=0

PROXY_NETWORK=fratelanza_default
BACKUP_RETENTION_DAYS=30

# Email (configure in Admin panel or here)
# NOTIFICATION_EMAIL=complaints@fratelanza.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
